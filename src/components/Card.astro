---
interface Props {
	title: string;
	body: string;
	href: string;
	tags?: string[];
}

const { href, title, body, tags } = Astro.props;
---

<a href={href} class="block group">
	<div
		class="glass p-8 rounded-2xl h-full transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-2xl group-hover:border-[var(--primary)]"
	>
		<h3
			class="text-2xl font-black uppercase tracking-wide mb-3 group-hover:text-[var(--primary)] transition-colors"
		>
			{title}
			<span
				class="inline-block transition-transform group-hover:translate-x-1"
				>→</span
			>
		</h3>
		<p class="text-[var(--text-muted)] mb-6 leading-relaxed font-medium">
			{body}
		</p>

		{
			tags && (
				<div class="flex flex-wrap gap-2 mt-auto">
					{tags.map((tag) => (
						<span class="text-xs font-mono py-1 px-3 rounded-md bg-[var(--bg-dark)] text-[var(--text-muted)] border border-zinc-700">
							{tag}
						</span>
					))}
				</div>
			)
		}
	</div>
</a>
