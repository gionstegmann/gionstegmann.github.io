---
interface Props {
	title: string;
	body: string;
	href: string;
  tags?: string[];
}

const { href, title, body, tags } = Astro.props;
---

<a href={href} class="block group">
	<div class="glass p-8 rounded-2xl h-full transition-all duration-300 group-hover:-translate-y-2 group-hover:shadow-[0_0_30px_rgba(124,58,237,0.2)] border border-white/5 group-hover:border-[var(--primary)]/30">
		<h3 class="text-2xl font-bold mb-3 group-hover:text-[var(--primary)] transition-colors">
			{title}
			<span class="inline-block transition-transform group-hover:translate-x-1">→</span>
		</h3>
		<p class="text-gray-400 mb-6 leading-relaxed">
			{body}
		</p>
    
    {tags && (
      <div class="flex flex-wrap gap-2 mt-auto">
        {tags.map((tag) => (
          <span class="text-xs font-mono py-1 px-3 rounded-full bg-white/5 text-gray-300 border border-white/10">
            {tag}
          </span>
        ))}
      </div>
    )}
	</div>
</a>
