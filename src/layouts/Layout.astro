---
import { Image } from "astro:assets";
import logoLight from "../assets/logo-light.svg";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Portfolio of Gion - Developer & Creative"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Google Fonts: Montserrat & JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-[var(--bg-dark)] text-[var(--text-main)] antialiased font-sans"
	>
		<!-- Sticky Solid Header (Compact) -->
		<header
			class="fixed top-0 w-full z-50 transition-all duration-300 bg-[var(--tertiary)] border-b border-zinc-700 shadow-lg"
		>
			<div
				class="container mx-auto px-6 py-3 flex justify-between items-center max-w-5xl"
			>
				<a href="/" class="block hover:opacity-80 transition-opacity">
					<Image
						src={logoLight}
						alt="GION"
						height={32}
						class="h-8 w-auto"
					/>
				</a>

				<nav
					class="flex gap-4 md:gap-6 text-xs uppercase tracking-widest font-bold text-[var(--text-muted)]"
				>
					<a
						href="/projects"
						class="hover:text-white transition-colors">Projects</a
					>
					<a href="/blog" class="hover:text-white transition-colors"
						>Blog</a
					>
					<a href="/resume" class="hover:text-white transition-colors"
						>Resume</a
					>
				</nav>
			</div>
		</header>

		<slot />

		<footer
			class="py-6 text-center text-gray-700 text-xs font-mono border-t border-white/5 mt-12"
		>
			<p>
				~/gion-stegmann <span class="mx-2">|</span> built_with: [astro, tailwind]
			</p>
		</footer>
	</body>
</html>
