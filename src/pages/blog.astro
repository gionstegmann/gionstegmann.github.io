---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Fetch posts from src/content/blog/
const posts = (await getCollection("blog"))
  .filter((post) => post.id !== "boilerplate.md") // Filter out boilerplate
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | Gion Stegmann">
  <main class="container mx-auto px-6 pt-32 pb-20 max-w-3xl">
    <h1 class="text-4xl font-black mb-12 flex items-center gap-4">
      <span class="text-[var(--secondary)]">./</span>LOGS
    </h1>

    <div class="flex flex-col gap-4">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block p-6 border border-zinc-800 rounded-lg hover:border-[var(--secondary)] hover:bg-[var(--bg-card)] transition-all shadow-lg hover:-translate-y-1"
          >
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-bold text-[var(--text-main)] group-hover:text-[var(--secondary)] transition-colors uppercase">
                {post.data.title}
              </h2>
              <span class="text-xs font-mono text-[var(--text-muted)]">
                {post.data.pubDate.toISOString().slice(0, 10)}
              </span>
            </div>
            <p class="text-[var(--text-muted)] text-sm font-medium">
              {post.data.description}
            </p>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
