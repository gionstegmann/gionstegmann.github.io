---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. For your template, you can access the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title + " | Gion Stegmann"}>
  <main class="container mx-auto px-6 pt-32 pb-20 max-w-3xl">
    <!-- Post Header -->
    <div class="mb-12 border-b border-zinc-800 pb-8">
      <div
        class="flex items-center gap-3 mb-4 text-sm text-[var(--text-muted)] font-mono"
      >
        <a href="/blog" class="hover:text-[var(--secondary)] transition-colors"
          >← BACK_TO_LOGS</a
        >
        <span>/</span>
        <span class="text-[var(--secondary)]"
          >{entry.data.pubDate.toISOString().slice(0, 10)}</span
        >
      </div>
      <h1 class="text-4xl md:text-5xl font-black mb-6 leading-tight uppercase">
        {entry.data.title}
      </h1>
      <p
        class="text-xl text-[var(--text-muted)] leading-relaxed font-serif italic"
      >
        {entry.data.description}
      </p>

      {
        entry.data.heroImage && (
          <img
            src={entry.data.heroImage}
            alt={entry.data.title}
            class="w-full h-auto aspect-video object-cover rounded-xl border border-zinc-800 mt-8"
          />
        )
      }
    </div>

    <!-- Markdown Content -->
    <article
      class="prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:uppercase
      prose-a:text-[var(--secondary)] prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-xl prose-img:border prose-img:border-zinc-800
      prose-code:text-[var(--secondary)] prose-code:bg-[var(--bg-card)] prose-code:px-1 prose-code:rounded prose-code:before:content-none prose-code:after:content-none font-sans text-[var(--text-main)]"
    >
      <Content />
    </article>
  </main>
</Layout>
