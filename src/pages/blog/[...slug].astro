---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

// 2. For your template, you can access the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title + " | Gion Stegmann"}>
  <main class="container mx-auto px-6 pt-32 pb-20 max-w-3xl">
    
    <!-- Post Header -->
    <div class="mb-12 border-b border-white/10 pb-8">
      <div class="flex items-center gap-3 mb-4 text-sm text-gray-500 font-mono">
        <a href="/blog" class="hover:text-[var(--primary)] transition-colors">← BACK_TO_LOGS</a>
        <span>/</span>
        <span class="text-[var(--primary)]">{entry.data.pubDate.toISOString().slice(0,10)}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-black mb-6 leading-tight">{entry.data.title}</h1>
      <p class="text-xl text-gray-400 leading-relaxed font-serif italic">{entry.data.description}</p>
    </div>

    <!-- Markdown Content -->
    <article class="prose prose-invert prose-lg max-w-none 
      prose-headings:font-bold prose-headings:tracking-tight
      prose-a:text-[var(--primary)] prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-xl prose-img:border prose-img:border-white/10
      prose-code:text-[var(--secondary)] prose-code:bg-white/5 prose-code:px-1 prose-code:rounded prose-code:before:content-none prose-code:after:content-none font-sans text-gray-300">
      <Content />
    </article>

  </main>
</Layout>
