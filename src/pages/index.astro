---
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profilePic from "../assets/profile-pic.png";


const allProjects = await getCollection("projects");
const ORDER = [
  "Nomad Translate",
  "MudMudMoto",
  "DawnShift",
  "Job Applications Pipeline",
];
const recentProjects = allProjects
  .sort((a, b) => {
    // Keep same order as projects page
    const indexA = ORDER.indexOf(a.data.title);
    const indexB = ORDER.indexOf(b.data.title);
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
  })
  .slice(0, 3)
  .map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    stack: p.data.tags ? p.data.tags[0] : "Project",
    link: `/projects/${p.slug}`,
  }));

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .filter((post) => post.id !== "boilerplate.md")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    date: post.data.pubDate.toISOString().split("T")[0],
    link: `/blog/${post.slug}`,
  }));

// Decode XML/HTML entities
function decodeEntities(str: string): string {
  return str
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'");
}

// Fetch Letterboxd RSS feed
let recentFilms: { title: string; year: string; rating: string; poster: string; link: string }[] = [];
try {
  const rssRes = await fetch("https://letterboxd.com/gioni_mango/rss/");
  const rssText = await rssRes.text();

  const itemMatches = rssText.match(/<item>[\s\S]*?<\/item>/g) || [];
  recentFilms = itemMatches.slice(0, 6).map((item) => {
    const title = decodeEntities((item.match(/<letterboxd:filmTitle><!\[CDATA\[([\s\S]*?)\]\]><\/letterboxd:filmTitle>/)?.[1]
      || item.match(/<letterboxd:filmTitle>(.*?)<\/letterboxd:filmTitle>/)?.[1]
      || "Unknown")).trim();
    const year = (item.match(/<letterboxd:filmYear>(.*?)<\/letterboxd:filmYear>/)?.[1] || "").trim();
    const rating = (item.match(/<letterboxd:memberRating>(.*?)<\/letterboxd:memberRating>/)?.[1] || "").trim();
    const poster = (item.match(/<p><img src="(.*?)"\/><\/p>/)?.[1] || "").trim();
    const link = (item.match(/<link>(https:\/\/letterboxd\.com\/[^<]*)<\/link>/)?.[1] || "https://letterboxd.com/gioni_mango/").trim();
    return { title, year, rating, poster, link };
  });
} catch (e) {
  console.warn("Failed to fetch Letterboxd RSS:", e);
}

// Convert numeric rating to star display
function ratingToStars(rating: string): string {
  const num = parseFloat(rating);
  if (isNaN(num)) return "";
  const full = Math.floor(num);
  const half = num % 1 >= 0.25 ? 1 : 0;
  const empty = 5 - full - half;
  return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(empty);
}
---

<Layout title="~/gion-stegmann">
  <main class="container mx-auto px-6 pt-24 pb-12 max-w-5xl">
    <!-- Header / Bio -->
    <section class="mb-12 border-b border-zinc-800 pb-8">
      <div
        class="flex flex-col md:flex-row items-center gap-8 md:items-start md:justify-between"
      >
        <div class="flex-1">
          <h1 class="text-3xl font-black mb-2 tracking-tight uppercase">
            Gion Stegmann
          </h1>
          <p class="text-[var(--primary)] font-mono text-base mb-4">
            Adventurer // Builder // Creative //
          </p>
          <p
            class="text-[var(--text-muted)] max-w-2xl leading-relaxed text-base font-medium"
          >
            Based in Zurich with roots in Belgium.
            <br />
            I studied Computer Science at ETH Zurich. Did a lot of startup-related
            stuff next to that. Worked for a startup accelerator and a VC. Then went
            on to travel all the way to Kazakhstan on my old 2001 Suzuki DR650. Now
            I'm focussing on building my own stuff.
          </p>
        </div>
        <div class="hidden md:block shrink-0">
          <Image
            src={profilePic}
            alt="Gion Stegmann"
            width={512}
            height={512}
            class="rounded-2xl shadow-xl w-48 h-48 object-cover border border-zinc-700/50"
          />
        </div>
      </div>
    </section>

    <!-- Dashboard Grid -->
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Left Col: Projects -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2
            class="text-xl font-bold flex items-center gap-2 text-[var(--text-main)]"
          >
            <span class="text-[var(--primary)]">./</span>
            LATEST_PROJECTS
          </h2>
          <a
            href="/projects"
            class="text-xs text-[var(--text-muted)] hover:text-white transition-colors uppercase tracking-wider"
            >[view_all]</a
          >
        </div>

        <div class="flex flex-col gap-3">
          {
            recentProjects.map((p) => (
              <a
                href={p.link}
                class="group block p-4 bg-[var(--bg-card)] border border-zinc-800 hover:border-[var(--primary)] transition-all rounded-xl shadow-lg hover:-translate-y-1"
              >
                <div class="flex justify-between items-start">
                  <h3 class="font-bold text-sm text-[var(--text-main)] group-hover:text-[var(--primary)] transition-colors uppercase">
                    {p.title}
                  </h3>
                  <span class="text-[10px] font-mono text-[var(--text-muted)] border border-zinc-700 px-1 rounded bg-[var(--bg-dark)]">
                    {p.stack}
                  </span>
                </div>
                <p class="text-xs text-[var(--text-muted)] mt-1 font-medium">
                  {p.desc}
                </p>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Right Col: Thoughts/Log -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2
            class="text-xl font-bold flex items-center gap-2 text-[var(--text-main)]"
          >
            <span class="text-[var(--secondary)]">./</span>
            LOGS
          </h2>
          <a
            href="/blog"
            class="text-xs text-[var(--text-muted)] hover:text-white transition-colors uppercase tracking-wider"
            >[view_all]</a
          >
        </div>

        <div class="flex flex-col gap-2">
          {
            recentPosts.map((post, i) => (
              <a
                href={post.link}
                class="group flex items-center gap-4 py-3 border-b border-dashed border-zinc-800 hover:border-[var(--secondary)] hover:bg-[var(--bg-card)] transition-colors px-2 rounded-sm"
              >
                <span class="text-xs font-mono text-[var(--text-muted)] w-24">
                  {post.date}
                </span>
                <span class="text-sm text-[var(--text-main)] group-hover:text-[var(--secondary)] transition-colors line-clamp-1 font-medium">
                  {post.title}
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <!-- Recently Watched (Letterboxd) -->
    {recentFilms.length > 0 && (
      <section class="mt-12 border-t border-zinc-800 pt-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold flex items-center gap-2 text-[var(--text-muted)] uppercase tracking-wider">
            <span>🎬</span> recently watched
            <a
              href="https://letterboxd.com/gioni_mango/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[10px] text-zinc-600 hover:text-white transition-colors font-mono"
              >on letterboxd</a
            >
          </h2>
        </div>
        <div class="flex gap-4 overflow-x-auto">
          {recentFilms.map((film) => (
            <a
              href={film.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group shrink-0 w-24"
            >
              <div class="w-24 h-36 overflow-hidden rounded-md border border-zinc-800 group-hover:border-[var(--primary)] transition-all bg-[var(--tertiary)]">
                {film.poster ? (
                  <img
                    src={film.poster}
                    alt={film.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center p-1">
                    <span class="text-[var(--text-muted)] text-[9px] text-center font-mono">{film.title}</span>
                  </div>
                )}
              </div>
              <p class="mt-1.5 text-[11px] font-bold text-[var(--text-main)] group-hover:text-[var(--primary)] transition-colors line-clamp-1">
                {film.title}
              </p>
              <p class="text-[9px] text-[var(--text-muted)] font-mono flex items-center gap-1">
                <span>{film.year}</span>
                {film.rating && <span class="text-[var(--primary)]">{ratingToStars(film.rating)}</span>}
              </p>
            </a>
          ))}
          <!-- See All box -->
          <a
            href="https://letterboxd.com/gioni_mango/"
            target="_blank"
            rel="noopener noreferrer"
            class="group shrink-0 w-24"
          >
            <div class="w-24 h-36 overflow-hidden rounded-md border border-zinc-700 border-dashed group-hover:border-[var(--primary)] transition-all bg-[var(--tertiary)] flex items-center justify-center">
              <div class="text-center">
                <span class="text-lg text-[var(--text-muted)] group-hover:text-[var(--primary)] transition-colors">→</span>
                <p class="text-[9px] text-[var(--text-muted)] group-hover:text-[var(--primary)] transition-colors font-mono mt-1">see all</p>
              </div>
            </div>
            <p class="mt-1.5 text-[11px] font-bold text-[var(--text-muted)] group-hover:text-[var(--primary)] transition-colors line-clamp-1">
              &nbsp;
            </p>
            <p class="text-[9px] text-[var(--text-muted)] font-mono">&nbsp;</p>
          </a>
        </div>
      </section>
    )}

    <!-- Connect -->
    <section class="mt-16 border-t border-zinc-800 pt-8">
      <h2
        class="text-xl font-bold flex items-center gap-2 text-[var(--text-main)] mb-6"
      >
        <span class="text-[var(--primary)]">./</span>
        CONNECT
      </h2>

      <div class="flex flex-wrap gap-4">
        <a
          href="https://www.linkedin.com/in/gionstegmann/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 px-5 py-3 bg-[var(--tertiary)] border border-zinc-700 hover:border-[var(--primary)] rounded-xl transition-all hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-[var(--text-muted)] group-hover:text-[var(--primary)] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <div>
            <p class="text-sm font-bold text-[var(--text-main)] group-hover:text-[var(--primary)] transition-colors">
              LinkedIn
            </p>
            <p class="text-[10px] text-[var(--text-muted)] font-mono">/in/gionstegmann</p>
          </div>
        </a>

        <a
          href="https://letterboxd.com/gioni_mango/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 px-5 py-3 bg-[var(--tertiary)] border border-zinc-700 hover:border-[var(--primary)] rounded-xl transition-all hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-[var(--text-muted)] group-hover:text-[var(--primary)] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm4.995 17.176c-.436.548-1.374.984-2.495.984-1.513 0-2.635-.791-3.302-1.472l-.046-.044c-.253-.263-.418-.431-.418-.431s-.165.168-.418.431c-.046.048-.093.091-.14.137-.667.681-1.789 1.472-3.302 1.472-1.121 0-2.059-.436-2.495-.984-.372-.468-.705-1.098-.705-1.682 0-1.238.938-2.474 2.508-2.474.635 0 1.191.252 1.615.645l.283.265.283-.265c.424-.393.98-.645 1.615-.645 1.57 0 2.508 1.236 2.508 2.474 0 .584-.333 1.214-.705 1.682zM24 12c0 4.418-3.582 8-8 8-2.01 0-3.861-.745-5.256-1.984C11.303 17.27 12 15.712 12 14V5.832h.003c.395.097.806.168 1.231.168 3.308 0 6.086-2.154 6.854-5.107C22.577 2.445 24 5.676 24 12z"/>
          </svg>
          <div>
            <p class="text-sm font-bold text-[var(--text-main)] group-hover:text-[var(--primary)] transition-colors">
              Letterboxd
            </p>
            <p class="text-[10px] text-[var(--text-muted)] font-mono">/gioni_mango</p>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>
