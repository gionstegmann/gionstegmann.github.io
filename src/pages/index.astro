---
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const ORDER = ["MudMudMoto", "DawnShift", "Job Applications Pipeline"];
const recentProjects = allProjects
  .sort((a, b) => {
    // Keep same order as projects page
    const indexA = ORDER.indexOf(a.data.title);
    const indexB = ORDER.indexOf(b.data.title);
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
  })
  .slice(0, 3)
  .map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    stack: p.data.tags ? p.data.tags[0] : "Project", // Use first tag as stack label for this compact view
    link: `/projects/${p.slug}`,
  }));

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .filter((post) => post.id !== "boilerplate.md") // Filter out boilerplate
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    date: post.data.pubDate.toISOString().split("T")[0],
    link: `/blog/${post.slug}`,
  }));
---

<Layout title="Gion Stegmann | ⌘">
  <main class="container mx-auto px-6 pt-24 pb-12 max-w-5xl">
    <!-- Header / Bio -->
    <section class="mb-16 border-b border-white/5 pb-8">
      <h1 class="text-3xl font-black mb-2 tracking-tight">Gion Stegmann</h1>
      <p class="text-[var(--primary)] font-mono text-sm mb-4">
        Adventurer // Builder // Creative //
      </p>
      <p class="text-gray-400 max-w-2xl leading-relaxed text-sm">
        Based in Zurich with roots in Belgium.
        <br />
        I studied Computer Science at ETH Zurich. Did a lot of startup-related stuff
        next to that. Worked for a startup accelerator and a VC. Then went on to
        travel all the way to Kazakhstan on my old 2001 Suzuki DR650.
      </p>
    </section>

    <!-- Dashboard Grid -->
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Left Col: Projects -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-bold flex items-center gap-2">
            <span class="text-[var(--primary)] text-xs">●</span>
            LATEST_PROJECTS
          </h2>
          <a
            href="/projects"
            class="text-xs text-gray-500 hover:text-white transition-colors"
            >[view_all]</a
          >
        </div>

        <div class="flex flex-col gap-3">
          {
            recentProjects.map((p) => (
              <a
                href={p.link}
                class="group block p-4 bg-white/[0.02] border border-white/5 hover:border-[var(--primary)]/30 hover:bg-white/[0.04] transition-all rounded-md"
              >
                <div class="flex justify-between items-start">
                  <h3 class="font-bold text-sm text-gray-200 group-hover:text-[var(--primary)] transition-colors">
                    {p.title}
                  </h3>
                  <span class="text-[10px] font-mono text-gray-600 border border-white/10 px-1 rounded">
                    {p.stack}
                  </span>
                </div>
                <p class="text-xs text-gray-500 mt-1">{p.desc}</p>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Right Col: Thoughts/Log -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-bold flex items-center gap-2">
            <span class="text-[var(--secondary)] text-xs">●</span>
            LOGS
          </h2>
          <a
            href="/blog"
            class="text-xs text-gray-500 hover:text-white transition-colors"
            >[view_all]</a
          >
        </div>

        <div class="flex flex-col gap-2">
          {
            recentPosts.map((post, i) => (
              <a
                href={post.link}
                class="group flex items-center gap-4 py-2 border-b border-dashed border-white/5 hover:bg-white/[0.02] transition-colors px-2 rounded-sm"
              >
                <span class="text-xs font-mono text-gray-600 w-24">
                  {post.date}
                </span>
                <span class="text-sm text-gray-300 group-hover:text-[var(--secondary)] transition-colors line-clamp-1">
                  {post.title}
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
